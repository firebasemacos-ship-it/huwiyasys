/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and transactions.
 * Products and categories are publicly readable, but only authorized users can create, update, or delete them.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /users/{userId}/transactions/{transactionId}: Stores transaction history for each user, accessible only to the user themselves.
 * - /admins/{adminId}: Stores admin user profiles, only accessible by the admin themselves.
 * - /products/{productId}: Stores product information, publicly readable but writeable by authorized users only.
 * - /categories/{categoryId}: Stores product categories, publicly readable but writeable by authorized users only.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and transaction history.
 * - Listing user documents is disallowed to prevent unauthorized data access.
 * - Public read access is granted for /products and /categories.
 * - The `isAdmin` flag in the user profile determines elevated privileges.  Currently, no rules leverage the `isAdmin` field, but it's included in the data model.
 *
 * Denormalization for Authorization:
 * No specific denormalization is used in this ruleset. The current security model relies on path-based authorization (user ownership) and role-based authorization (admin status - currently not used).
 *
 * Structural Segregation:
 * Private user data is stored under the /users/{userId} path, while public product and category data are stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile data. Only the user themselves can read or write their profile.
     * @path /users/{userId}
     * @allow (create) User with uid 'user123' creates their profile at /users/user123.
     * @allow (get) User with uid 'user123' reads their profile at /users/user123.
     * @allow (update) User with uid 'user123' updates their profile at /users/user123.
     * @allow (delete) User with uid 'user123' deletes their profile at /users/user123.
     * @deny (get) User with uid 'user456' tries to read user 'user123's profile.
     * @deny (create) User with uid 'user123' tries to create a profile at /users/user456.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects user transaction data. Only the user themselves can read or write their transactions.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User with uid 'user123' creates a transaction at /users/user123/transactions/tx1.
     * @allow (get) User with uid 'user123' reads their transaction at /users/user123/transactions/tx1.
     * @allow (update) User with uid 'user123' updates their transaction at /users/user123/transactions/tx1.
     * @allow (delete) User with uid 'user123' deletes their transaction at /users/user123/transactions/tx1.
     * @deny (get) User with uid 'user456' tries to read user 'user123's transaction.
     * @deny (create) User with uid 'user123' tries to create a transaction at /users/user456/transactions/tx1.
     * @principle Enforces document ownership for all operations on user transactions.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects admin profile data. Only the admin themselves can read or write their profile.
     * @path /admins/{adminId}
     * @allow (create) User with uid 'admin123' creates their admin profile at /admins/admin123.
     * @allow (get) User with uid 'admin123' reads their admin profile at /admins/admin123.
     * @allow (update) User with uid 'admin123' updates their admin profile at /admins/admin123.
     * @allow (delete) User with uid 'admin123' deletes their admin profile at /admins/admin123.
     * @deny (get) User with uid 'user456' tries to read admin 'admin123's profile.
     * @deny (create) User with uid 'admin123' tries to create a profile at /admins/admin456.
     * @principle Enforces document ownership for all operations on admin profiles.
     */
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false;
      allow create: if isOwner(adminId) && request.resource.data.uid == adminId;
      allow update: if isExistingOwner(adminId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(adminId);
    }

    /**
     * @description Allows public read access to products but restricts write access.
     * @path /products/{productId}
     * @allow (get) Any user can read a product.
     * @allow (list) Any user can list products.
     * @deny (create) Anonymous user tries to create a product.
     * @deny (update) Regular user tries to update a product.
     * @deny (delete) Regular user tries to delete a product.
     * @principle Public read access with owner-only writes.
     */
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to categories but restricts write access.
     * @path /categories/{categoryId}
     * @allow (get) Any user can read a category.
     * @allow (list) Any user can list categories.
     * @deny (create) Anonymous user tries to create a category.
     * @deny (update) Regular user tries to update a category.
     * @deny (delete) Regular user tries to delete a category.
     * @principle Public read access with owner-only writes.
     */
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}