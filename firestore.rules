/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing authentication and ownership for writes
 * while keeping data validation minimal to allow for rapid schema iteration.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information.
 * - /products/{productId}: Stores product information.
 *
 * Key Security Decisions:
 * - Users can only create their own profile.
 * - Users can update their own profile.
 * - Users cannot list all profiles.
 * - Products are publicly readable.
 * - Products can only be created, updated, or deleted by an admin user.
 *
 * Denormalization for Authorization:
 * The `isAdmin` field on the `/users/{userId}` document is used for authorization.
 * This avoids the need for a separate roles collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures user profiles. Users can create and manage their own profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (update) - Authenticated user can update their own profile if the userId matches their auth.uid.
     * @allow (get) - Any authenticated user can read a user profile.
     * @deny (list) - Listing all users is prohibited.
     * @deny (delete) - Users cannot delete their profiles via the rules.
     * @principle Enforces document ownership for writes, restricts listing of user profiles.
     */
    match /users/{userId} {
      // Helpers
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Read Rules
      allow get: if isSignedIn();
      allow list: if false;

      // Write Rules
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    /**
     * @description Secures products. Products are publicly readable, but only admins can create, update, or delete them.
     * @path /products/{productId}
     * @allow (get) - Anyone can read product information.
     * @allow (list) - Anyone can list products.
     * @allow (create) - Only admins can create products.
     * @allow (update) - Only admins can update products.
     * @allow (delete) - Only admins can delete products.
     * @deny - Non-admins cannot create, update, or delete products.
     * @principle Public read, admin-only writes.
     */
    match /products/{productId} {
      // Helpers
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      // Read Rules
      allow get: if true;
      allow list: if true;

      // Write Rules
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}