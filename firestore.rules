rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for profile data.
     * @path /users/{userId}
     * @allow (create) User can create their profile if userId matches auth.uid.
     * @allow (get, update, delete) User can access/modify their profile.
     * @deny (create) User cannot create a profile for another user.
     * @deny (list) No one can list all user profiles.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data != null;
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data != null;
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces user-ownership for transaction data.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User can create a transaction if userId matches auth.uid.
     * @allow (get, list, update, delete) User can access/modify their transactions.
     * @deny (create) User cannot create a transaction for another user.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data != null;
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data != null;
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces admin-only access for admin profiles.
     * @path /admins/{adminId}
     * @allow (create, get, update, delete) Only admins can manage admin profiles.
     * @deny (list) No one can list all admin profiles.
     * @principle Restricts access to administrative users only.
     */
    match /admins/{adminId} {
      function isAdmin() {
        return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
      }
      function isSignedIn() {
          return request.auth != null;
      }
      allow get: if isSignedIn() && isAdmin();
      allow list: if false;
      allow create: if isSignedIn() && isAdmin() && request.resource.data != null;
      allow update: if isSignedIn() && isAdmin() && request.resource.data != null;
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows public read access but restricts write access to admins for products.
     * @path /products/{productId}
     * @allow (get, list) Public read access to products.
     * @allow (create, update, delete) Only admins can manage products.
     * @principle Allows public reads with owner-only writes.
     */
    match /products/{productId} {
        function isAdmin() {
          return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn() && isAdmin() && request.resource.data != null;
        allow update: if isSignedIn() && isAdmin() && request.resource.data != null;
        allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows public read access but restricts write access to admins for categories.
     * @path /categories/{categoryId}
     * @allow (get, list) Public read access to categories.
     * @allow (create, update, delete) Only admins can manage categories.
     * @principle Allows public reads with owner-only writes.
     */
    match /categories/{categoryId} {
        function isAdmin() {
          return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn() && isAdmin() && request.resource.data != null;
        allow update: if isSignedIn() && isAdmin() && request.resource.data != null;
        allow delete: if isSignedIn() && isAdmin();
    }
  }
}