/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and transactions.
 * Products and categories are publicly readable but only modifiable by admins.
 *
 * Data Structure:
 * - /users/{userId}: User profile information, owned by the user.
 * - /users/{userId}/transactions/{transactionId}: Transaction history for each user.
 * - /admins/{adminId}: Admin profiles (potentially for future use).
 * - /products/{productId}: Publicly available product information.
 * - /categories/{categoryId}: Publicly available product categories.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data and transaction history.
 * - Public read access to products and categories allows for open browsing.
 * - Admin-only write access for products and categories ensures data integrity.
 * - The `isAdmin` flag on the user profile is not directly used in the rules but could be used in the future to grant broader access.
 *
 * Denormalization for Authorization:
 * - The `uid` is denormalized into the `/users/{userId}` document, enabling the `isOwner()` check.
 *
 * Structural Segregation:
 * - Public product data is stored in a top-level collection (/products), separate from private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, list): Any user can read any profile
     * @allow (create): Only the user with matching {userId} can create their profile.
     * @allow (update, delete): Only the user with matching {userId} can update or delete their profile.
     * @deny (create): If the uid in the request does not match the userId in the path.
     * @deny (update, delete): If the user attempts to update or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.uid == userId;
      }

      allow get, list: if true;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to a user's transaction history.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (get, list): Only the user with matching {userId} can read their transactions.
     * @allow (create): Only the user with matching {userId} can create a transaction in their account.
     * @allow (update, delete): Only the user with matching {userId} can update or delete a transaction in their account.
     * @deny (create): If the user attempts to create a transaction for another user.
     * @deny (update, delete): If the user attempts to modify or delete another user's transaction.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/transactions/{transactionId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isOwner(userId) {
            return isSignedIn() && request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
            return isSignedIn() && request.auth.uid == userId && resource.data.uid == userId;
        }
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to admin profile information.
     * @path /admins/{adminId}
     * @allow (get, list): Only signed in users can list admins.
     * @allow (create, update, delete): No one can create, update, or delete admin profiles via client SDKs.
     * @principle Restricts modification of admin profiles.
     */
    match /admins/{adminId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

     /**
      * @description Controls access to product information.
      * @path /products/{productId}
      * @allow (get, list): Anyone can read product information.
      * @allow (create, update, delete): Only authenticated admins can create, update, or delete products.
      * @principle Restricts modification of product data to admins.
      */
    match /products/{productId} {
        function isSignedIn() {
            return request.auth != null;
        }

        // TODO: Implement a more robust admin check (e.g., read from a custom claim).
        function isAdmin() {
            return isSignedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }

        allow get, list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

    /**
     * @description Controls access to category information.
     * @path /categories/{categoryId}
     * @allow (get, list): Anyone can read category information.
     * @allow (create, update, delete): Only authenticated admins can create, update, or delete categories.
     * @principle Restricts modification of category data to admins.
     */
    match /categories/{categoryId} {
        function isSignedIn() {
            return request.auth != null;
        }

        // TODO: Implement a more robust admin check (e.g., read from a custom claim).
        function isAdmin() {
            return isSignedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }

        allow get, list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
  }
}