rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return request.auth.email == 'zaki@zetabait.app';
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isManager() {
      return exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow user to update their own document, or allow a super admin to do so.
      // Additionally, allow a signed-in user to update ONLY the wallet.balance of another user.
      // This is a simplified rule for balance transfers and should ideally be handled by a Cloud Function for better security.
      allow write: if (isOwner(userId) || isSuperAdmin()) || 
                   (isSignedIn() && request.resource.data.keys().hasOnly(['wallet']) && request.resource.data.wallet.keys().hasOnly(['balance']));
    }
    
    match /managers/{managerId} {
      allow read, write: if isOwner(managerId) || isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }
    
    match /banners/{bannerId} {
        allow read: if isSignedIn();
        allow write: if isManager();
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read, create: if isOwner(userId);
      allow update, delete: if false; // Transactions are immutable
    }

    match /cardLinkRequests/{requestId} {
        allow read, write: if isSignedIn();
    }
  }
}
