/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes rapid prototyping by focusing on authorization and basic relational integrity while relaxing data validation.  It enforces a strict user-ownership model for user-specific data and allows public read access to product and category information.  It also provides admin access for `/admins/{adminId}` collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/transactions/{transactionId}: Stores transaction history for each user.
 * - /admins/{adminId}: Stores admin user profiles.
 * - /products/{productId}: Stores product information.
 * - /categories/{categoryId}: Stores product categories.
 *
 * Key Security Decisions:
 * - User data is strictly owned by the user; no listing of users is allowed.
 * - Public read access is granted to products and categories.
 * - Admin access is granted to `/admins/{adminId}` collections.
 * - Only critical relational integrity checks are performed (e.g., creatorId on create).
 * - No schema validation is performed beyond relational integrity to allow flexible data shapes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profile information.
     * @path /users/{userId}
     * @allow (create) - If the authenticated user's ID matches the userId.
     * @allow (get, list, update, delete) - If the authenticated user's ID matches the userId and document exist.
     * @deny (create) - If the authenticated user's ID does not match the userId.
     * @deny (get, list, update, delete) - If the authenticated user's ID does not match the userId or the document doesn't exist.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // No listing of users.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to user transaction history.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) - If the authenticated user's ID matches the userId.
     * @allow (get, list, update, delete) - If the authenticated user's ID matches the userId and document exists.
     * @deny (create) - If the authenticated user's ID does not match the userId.
     * @deny (get, list, update, delete) - If the authenticated user's ID does not match the userId or the document doesn't exist.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to admin profile information.
     * @path /admins/{adminId}
     * @allow (create) - If the authenticated user's ID matches the adminId.
     * @allow (get, list, update, delete) - If the authenticated user's ID matches the adminId and document exists.
     * @deny (create) - If the authenticated user's ID does not match the adminId.
     * @deny (get, list, update, delete) - If the authenticated user's ID does not match the adminId or the document doesn't exist.
     * @principle Enforces document ownership for writes.
     */
    match /admins/{adminId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(adminId) {
          return request.auth.uid == adminId;
        }

        function isExistingOwner(adminId) {
          return isOwner(adminId) && exists(resource);
        }

        allow get: if isSignedIn() && isOwner(adminId);
        allow list: if false;
        allow create: if isSignedIn() && isOwner(adminId);
        allow update: if isExistingOwner(adminId);
        allow delete: if isExistingOwner(adminId);
    }

    /**
     * @description Grants public read access to product information and restricts write access to owners.
     * @path /products/{productId}
     * @allow (get, list) - Anyone can read product information.
     * @allow (create) - Only if the authenticated user's ID matches the product's creatorId.
     * @allow (update, delete) - Only if the authenticated user is the existing owner of the product.
     * @deny (create) - If the authenticated user's ID does not match the product's creatorId.
     * @deny (update, delete) - If the authenticated user is not the owner of the product or the document doesn't exist.
     * @principle Allows public read access with owner-only writes.
     */
    match /products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerId) {
          return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
          return isOwner(ownerId) && exists(resource);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.ownerId);
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    /**
     * @description Grants public read access to category information and restricts write access to owners.
     * @path /categories/{categoryId}
     * @allow (get, list) - Anyone can read category information.
     * @allow (create) - Only if the authenticated user's ID matches the category's creatorId.
     * @allow (update, delete) - Only if the authenticated user is the existing owner of the category.
     * @deny (create) - If the authenticated user's ID does not match the category's creatorId.
     * @deny (update, delete) - If the authenticated user is not the owner of the category or the document doesn't exist.
     * @principle Allows public read access with owner-only writes.
     */
    match /categories/{categoryId} {
        function isSignedIn() {
          return request.auth != null;
        }

        function isOwner(ownerId) {
            return request.auth.uid == ownerId;
        }

        function isExistingOwner(ownerId) {
            return isOwner(ownerId) && exists(resource);
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(resource.data.ownerId);
        allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }
  }
}