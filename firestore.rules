/**
 * @fileoverview Firestore Security Rules for HuwiyaSys App
 *
 * Core Philosophy:
 * This ruleset implements a hybrid security model, combining role-based access control (for admins) and user-ownership for user profiles and related data. It prioritizes strict authorization to prevent unauthorized data access while maintaining a flexible data structure to facilitate rapid development.
 *
 * Data Structure:
 * - /users/{userId}: Stores public profile information for each user. Access is restricted to the user themselves or a super admin.
 * - /users/{userId}/transactions/{transactionId}: Stores a user's transaction history. Access is restricted to the user themselves or a super admin.
 * - /admins/{adminId}: Stores profile information for admin users. Full read/write access is only granted to super admins via email verification.
 * - /products/{productId}: Stores all available products in the application. Public read access, write access is restricted to the product owner.
 *
 * Key Security Decisions:
 * - Super Admin Role: A super admin can read and write any document in the database. This role is granted based on email verification.
 * - User Listing Disabled: Listing all users is not allowed for non-admins to protect user privacy.
 * - Products: Products are publicly readable. Write access is restricted to the owner.
 *
 * Denormalization for Authorization:
 * - The `Product` entity requires an `ownerId` field to properly implement owner-only writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if the user is a super admin based on email
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == "admin@huwiyasys.app";
    }

    // Grant full access to super admins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get) Signed-in user with matching userId.
     * @deny (get) Signed-in user with a different userId.
     * @allow (create) Signed-in user creating their own profile.
     * @deny (create) Signed-in user attempting to create another user's profile.
     * @allow (update) Signed-in user updating their own profile.
     * @deny (update) Signed-in user attempting to update another user's profile.
     * @allow (delete) Signed-in user deleting their own profile.
     * @deny (delete) Signed-in user attempting to delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to user transaction documents.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (get) Signed-in user with matching userId.
     * @deny (get) Signed-in user with a different userId.
     * @allow (create) Signed-in user creating transaction history.
     * @deny (create) Signed-in user attempting to create another user's transaction.
     * @allow (update) Signed-in user updating their own transaction history.
     * @deny (update) Signed-in user attempting to update another user's transaction history.
     * @allow (delete) Signed-in user deleting their own transaction history.
     * @deny (delete) Signed-in user attempting to delete another user's transaction history.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/transactions/{transactionId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId); // Owner can list their own transactions.
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to product documents.
     * @path /products/{productId}
     * @allow (get) Anyone can read product details.
     * @allow (list) Anyone can list products.
     * @allow (create) Owner creating products.
     * @deny (create) Non-owner attempting to create products.
     * @allow (update) Owner updating products.
     * @deny (update) Non-owner attempting to update products.
     * @allow (delete) Owner deleting products.
     * @deny (delete) Non-owner attempting to delete products.
     * @principle Public read with owner-only writes.
     */
    match /products/{productId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }
      
      allow get, list: if true;

       allow create: if request.auth.uid == request.resource.data.ownerId;
       allow update: if isExistingOwner(resource.data.ownerId);
       allow delete: if isExistingOwner(resource.data.ownerId);
    }
  }
}