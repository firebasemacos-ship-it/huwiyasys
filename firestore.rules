
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if request.auth != null; // Allow only authenticated users
    }

    // Allow users to read their own user document
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
    }

    // Allow users to manage their own subcollections
    match /users/{userId}/{document=**} {
      allow read, write, create, delete: if request.auth.uid == userId;
    }
    
    // Allow reading of products and categories by any authenticated user
    match /products/{productId} {
      allow read: if request.auth != null;
    }
    match /categories/{categoryId} {
        allow read: if request.auth != null;
    }

    // Allow reading of banners by any authenticated user
    match /banners/{bannerId} {
        allow read: if request.auth != null;
    }
    
    // Admins (managers) can do anything
    match /managers/{managerId} {
        allow read, write: if request.auth.uid == managerId;
    }

    // A user can create a card link request
    match /cardLinkRequests/{requestId} {
        allow create: if request.auth != null && request.resource.data.requesterId == request.auth.uid;
        allow read, update: if request.auth != null && (request.resource.data.ownerId == request.auth.uid || request.resource.data.requesterId == request.auth.uid);
    }
    
     // Payment requests can be created by authenticated users
    match /paymentRequests/{requestId} {
      allow create: if request.auth.uid == request.resource.data.requesterId;
      // Owner and requester can read/update the request (e.g., owner to approve, requester to see status)
      allow read, update: if request.auth.uid == request.resource.data.ownerId || request.auth.uid == request.resource.data.requesterId;
    }
    
    // Orders can be created by authenticated users, if the order belongs to them
    match /orders/{orderId} {
        allow create: if request.auth.uid == request.resource.data.userId;
    }

    // Admins can access everything else for management
    // This is a simplified rule; in production, you'd be more specific
     match /{path=**} {
      allow read, write: if get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
