rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth.token.email == 'zaki@zetabait.app';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read;
      allow write: if isOwner(userId) || isSuperAdmin();
    }
    
    match /managers/{managerId} {
      allow read, write: if isOwner(managerId) || isSuperAdmin();
    }

    match /products/{productId} {
      allow read;
      allow write: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read;
      allow write: if isSuperAdmin();
    }

    match /cardLinkRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
