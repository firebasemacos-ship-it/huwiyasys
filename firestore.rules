/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a combination of user-based ownership and role-based access control.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the user and admins.
 * - /users/{userId}/transactions/{transactionId}: Stores transaction history, accessible only to the user and admins.
 * - /admins/{adminId}: Stores admin user profiles. Only admins can create/update/delete.
 * - /products/{productId}: Stores product information, publicly readable, but only admins can modify.
 * - /categories/{categoryId}: Stores product categories, publicly readable, but only admins can modify.
 *
 * Key Security Decisions:
 * - Strict user-ownership for profile data and transactions.
 * - Role-based access for administrative functions (product and category management).
 * - Public read access for products and categories to allow for open browsing.
 * - No user listing is allowed to prevent data scraping.
 *
 * Denormalization for Authorization:
 * - The `isAdmin` field is stored directly in the `/users/{userId}` document to avoid needing a separate lookup.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles. Only the user and admins can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - User with matching UID can create their profile.
     * @allow (get, update, delete) - User with matching UID or admin can access.
     * @deny (create) - User tries to create a profile with a mismatched UID.
     * @deny (list) - Listing all users is not allowed.
     * @principle Enforces document ownership and admin override.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
          return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
      }
      
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null && resource.data.uid == request.resource.data.uid;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

    /**
     * @description Protects user transactions. Only the user and admins can read/write their own transactions.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create, get, update, delete) - User with matching UID or admin can access.
     * @deny (create) - User tries to create a transaction with a mismatched UID.
     * @deny (list) - Listing all transactions is allowed only to the user or an admin.
     * @principle Enforces document ownership and admin override for transactions.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isAdmin() {
          return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
      }

      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && resource != null;
    }

    /**
     * @description Protects admin user profiles. Only admins can manage other admins.
     * @path /admins/{adminId}
     * @allow (create, get, update, delete) - Only admins can perform these operations.
     * @deny (create, update, delete) - Non-admins cannot modify admin profiles.
     * @deny (list) - Listing all admins is not allowed.
     * @principle Enforces role-based access control for admin management.
     */
    match /admins/{adminId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }

        allow get: if isSignedIn() && isAdmin();
        allow list: if false;
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin() && resource != null;
        allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Protects product information. Publicly readable, but only admins can modify.
     * @path /products/{productId}
     * @allow (get, list) - Products are publicly readable.
     * @allow (create, update, delete) - Only admins can perform these operations.
     * @deny (create, update, delete) - Non-admins cannot modify products.
     * @principle Public read access with role-based write access.
     */
    match /products/{productId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin() && resource != null;
        allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Protects product categories. Publicly readable, but only admins can modify.
     * @path /categories/{categoryId}
     * @allow (get, list) - Categories are publicly readable.
     * @allow (create, update, delete) - Only admins can perform these operations.
     * @deny (create, update, delete) - Non-admins cannot modify categories.
     * @principle Public read access with role-based write access.
     */
    match /categories/{categoryId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && isAdmin();
        allow update: if isSignedIn() && isAdmin() && resource != null;
        allow delete: if isSignedIn() && isAdmin() && resource != null;
    }
  }
}