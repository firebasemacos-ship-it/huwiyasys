rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user is the owner of the profile (userId matches request.auth.uid).
     * @deny (get, create, update, delete) if the user is not the owner of the profile (userId does not match request.auth.uid).
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows a user to read and write their own transaction history.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (get, create, update, delete) if the user is the owner of the transaction (userId matches request.auth.uid).
     * @deny (get, create, update, delete) if the user is not the owner of the transaction (userId does not match request.auth.uid).
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false; // Listing all transactions is disallowed, can be a security risk.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows an admin to read and write their own profile data.
     * @path /admins/{adminId}
     * @allow (get, create, update, delete) if the admin is the owner of the profile (adminId matches request.auth.uid).
     * @deny (get, create, update, delete) if the admin is not the owner of the profile (adminId does not match request.auth.uid).
     * @principle Enforces document ownership for all operations.
     */
    match /admins/{adminId} {
      function isOwner(adminId) {
        return request.auth != null && request.auth.uid == adminId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(adminId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == adminId;
      allow update: if isOwner(adminId);
      allow delete: if isOwner(adminId);
    }

    /**
     * @description Allows anyone to read products, but only authenticated users can create, update, or delete them.
     * @path /products/{productId}
     * @allow (get, list) to anyone.
     * @allow (create, update, delete) to authenticated users.
     * @deny (create, update, delete) to unauthenticated users.
     * @principle Public read, authenticated write.
     */
    match /products/{productId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows anyone to read categories, but only authenticated users can create, update, or delete them.
     * @path /categories/{categoryId}
     * @allow (get, list) to anyone.
     * @allow (create, update, delete) to authenticated users.
     * @deny (create, update, delete) to unauthenticated users.
     * @principle Public read, authenticated write.
     */
    match /categories/{categoryId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

      /**
       * @description Allows listing of cardLinkRequests
       * @path /cardLinkRequests
       * @allow list to anyone.
       * @principle Public read
       */
      match /cardLinkRequests/{cardLinkRequestId} {
          allow list: if true;
          allow get: if true;
          allow create: if isSignedIn();
          allow update: if false;
          allow delete: if false;
      }
  }
}