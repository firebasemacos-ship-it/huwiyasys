rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    // Rules for 'users' collection
    match /users/{userId} {
      // Allow users to read their own profile, and admins to read any profile.
      allow read: if isOwner(userId) || isAdmin();
      // Allow users to update their own profile, and admins to update any.
      allow write: if isOwner(userId) || isAdmin();
    }

    // Rules for user-specific subcollections like 'transactions'
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Rules for 'managers' collection
    match /managers/{managerId} {
      allow read, write: if isAdmin();
    }

    // Rules for 'products', 'categories', and 'banners'
    match /{collectionName}/{docId}
    where collectionName in ['products', 'categories', 'banners'] {
      allow read: if request.auth != null; // Allow any authenticated user to read
      allow write: if isAdmin(); // Only admins can write
    }

    // Rules for 'rechargeCards' collection
    match /rechargeCards/{cardId} {
        allow read, write: if isAdmin(); // Admins can manage cards
        // Any authenticated user can "use" a card by updating it, but only if it's not used yet.
        allow update: if request.auth != null
                    && request.resource.data.isUsed == true
                    && resource.data.isUsed == false;
    }

    // Rules for 'orders' collection
    match /orders/{orderId} {
        allow create: if isOwner(request.resource.data.userId); // User can create their own order
        allow read, update, delete: if isAdmin(); // Admin can manage all orders
    }

    // Rules for 'cardLinkRequests' collection
    match /cardLinkRequests/{requestId} {
        allow read: if isOwner(request.resource.data.requesterId) || isOwner(request.resource.data.ownerId);
        allow create: if isOwner(request.resource.data.requesterId);
        allow update: if isOwner(request.resource.data.ownerId); // Only the owner can accept/reject
    }

    // Rules for 'subscriptions' collection
    match /subscriptions/{subscriptionId} {
      // An admin can get any subscription. A user can only get their own.
      allow get: if isOwner(resource.data.userId) || isAdmin();
      // An admin can list all subscriptions. A user can only list their own subscriptions.
      allow list: if isAdmin() || (request.auth != null && request.query.where.size() > 0 && request.query.where[0][0] == 'userId' && request.query.where[0][2] == request.auth.uid);
      // Only admins can create, update, or delete subscriptions.
      allow write: if isAdmin();
    }
  }
}
