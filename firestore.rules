/**
 * @fileoverview Firestore Security Rules for huwiyasys.app.
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model:
 *   - User profiles are private and only accessible to the owning user.
 *   - Products and Categories are publicly readable but only modifiable by authorized users.
 *   - Super Admin access is granted via email verification.
 *
 * Data Structure:
 * - /users/{userId}: User profile documents, owned by the user with the matching UID.
 * - /users/{userId}/transactions/{transactionId}: Transaction history for a user.
 * - /products/{productId}: Product documents, publicly readable.
 * - /categories/{categoryId}: Category documents, publicly readable.
 * - /admins/{adminId}: Admin user profiles. Super Admin access is granted via email verification.
 *
 * Key Security Decisions:
 * - Super Admin: Full read/write access to all data. This is configured with `admin@huwiyasys.app`.
 * - User Listing Denied: Listing all users is not permitted except by a Super Admin.
 * - Public Read for Products and Categories: These collections are intended for public consumption.
 * - Strict Ownership for User Profiles: Each user can only access their own profile and transactions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Grant full access to super admins.
    function isSuperAdmin() {
      return request.auth != null &&
             request.auth.token.email == "admin@huwiyasys.app";
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    /**
     * @description Enforces access control for user profiles. Only the user themselves can read their profile.
     * @path /users/{userId}
     * @allow (get) User A can read their own profile if authenticated as User A.
     * @deny (get) User A cannot read User B's profile.
     * @principle Enforces document ownership for reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not allowed.

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces access control for user transactions. Only the user themselves can read or write their transaction.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) User A can create a transaction under their own user ID.
     * @deny (create) User A cannot create a transaction under User B's user ID.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
        function isOwner(userId) {
            return request.auth.uid == userId;
        }

        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to products, but restricts creation, update, and deletion to the product owner.
     * @path /products/{productId}
     * @allow (get) Any user can read a product.
     * @allow (list) Any user can list products.
     * @allow (create) User A can create a product if request.auth.uid == request.resource.data.ownerId.
     * @deny (create) User A cannot create a product if request.auth.uid != request.resource.data.ownerId.
     * @deny (update) User A cannot update a product they don't own.
     * @principle Public read with owner-only writes.
     */
    match /products/{productId} {
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }
      function isExistingOwner(ownerId) {
          return isOwner(ownerId) && resource != null;
      }
      allow get, list: if true;

      allow create: if request.auth.uid == request.resource.data.ownerId;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

       /**
        * @description Allows public read access to categories.
        * @path /categories/{categoryId}
        * @allow (get) Any user can read a category.
        * @allow (list) Any user can list categories.
        * @deny (create) No one can create categories through the client.
        * @deny (update) No one can update categories through the client.
        * @deny (delete) No one can delete categories through the client.
        * @principle Public read, no writes allowed.
        */
    match /categories/{categoryId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

  }
}