
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow user to update their own document, or admin to update any.
      // Also allow a very specific update to another user's balance for transfers.
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read, create: if isOwner(userId) || isAdmin();
    }
    
    match /products/{productId} {
      allow read;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read;
      allow write: if isAdmin();
    }

    match /cardLinkRequests/{requestId} {
      // Anyone can create a request.
      allow create: if request.auth != null;
      // Users can read/update requests they sent or received.
      allow read, update: if request.auth != null && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.ownerId);
    }
    
    match /banners/{bannerId} {
        allow read;
        allow write: if isAdmin();
    }

    match /managers/{managerId} {
      allow read, write: if isAdmin();
    }

    match /rechargeCards/{cardId} {
      allow read, create, delete: if isAdmin();
      // Allow admin to update anything.
      // Allow authenticated user to update a card from not used to used,
      // and only change the 'isUsed', 'usedBy', 'usedAt' fields.
      allow update: if isAdmin() || 
                      (request.auth != null && 
                       request.resource.data.isUsed == true && 
                       resource.data.isUsed == false &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt']));
    }
  }
}
