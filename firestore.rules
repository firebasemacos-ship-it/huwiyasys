/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and transactions.
 * Products and Categories are publicly readable, but write access is restricted.
 * Admin profiles are readable and writable by admins only.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, owned by the user.
 * - /users/{userId}/transactions/{transactionId}: Transaction history, owned by the user.
 * - /admins/{adminId}: Admin profiles, readable and writable by admins only.
 * - /products/{productId}: Publicly readable product catalog.
 * - /categories/{categoryId}: Publicly readable category list.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data and transaction history.
 * - Listing of users is disallowed.
 * - Products and Categories are publicly readable to enable the browsing of the product catalog.
 * - Only authenticated admins can manage admin profiles.
 * - All write operations require an authenticated user.
 *
 * Denormalization for Authorization:
 * - Currently, no denormalization is required as ownership is determined by the document path.
 *
 * Structural Segregation:
 * - Private user data (transactions) is stored in a subcollection under the user's profile.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with matching userId in the document.
     * @allow (get) - Authenticated user accessing their own profile.
     * @allow (update) - Authenticated user updating their own profile.
     * @allow (delete) - Authenticated user deleting their own profile.
     * @deny (create) - Authenticated user attempting to create a profile with a different userId.
     * @deny (get) - Authenticated user attempting to read another user's profile.
     * @deny (update) - Authenticated user attempting to update another user's profile.
     * @deny (delete) - Authenticated user attempting to delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their own transaction history.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) - Authenticated user adding a transaction to their own profile.
     * @allow (get) - Authenticated user accessing their own transaction.
     * @allow (update) - Authenticated user updating their own transaction.
     * @allow (delete) - Authenticated user deleting their own transaction.
     * @deny (create) - Authenticated user attempting to add a transaction to another user's profile.
     * @deny (get) - Authenticated user attempting to read another user's transaction.
     * @deny (update) - Authenticated user attempting to update another user's transaction.
     * @deny (delete) - Authenticated user attempting to delete another user's transaction.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && resource != null;
        allow delete: if isOwner(userId) && resource != null;
    }

        /**
         * @description Allows admins to read and write admin profile data.
         * @path /admins/{adminId}
         * @allow (create) - Authenticated admin user creating an admin profile.
         * @allow (get) - Authenticated admin user accessing admin profile.
         * @allow (update) - Authenticated admin user updating admin profile.
         * @allow (delete) - Authenticated admin user deleting admin profile.
         * @deny (create) - Non-admin user attempting to create an admin profile.
         * @deny (get) - Non-admin user attempting to access admin profile.
         * @deny (update) - Non-admin user attempting to update admin profile.
         * @deny (delete) - Non-admin user attempting to delete admin profile.
         * @principle Restricts admin profile management to authenticated admins.
         */
        match /admins/{adminId} {
          function isAdmin() {
                return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
          }
                allow get: if isAdmin();
                allow list: if false;
                allow create: if isAdmin() && request.resource.data.uid == adminId;
                allow update: if isAdmin() && resource != null;
                allow delete: if isAdmin() && resource != null;
        }

        /**
         * @description Allows public read access to products, but restricts write access.
         * @path /products/{productId}
         * @allow (get) - Any user can read product details.
         * @allow (list) - Any user can list products.
         * @deny (create) - Only authenticated admins can create a product.
         * @deny (update) - Only authenticated admins can update a product.
         * @deny (delete) - Only authenticated admins can delete a product.
         * @principle Public read access with restricted write access.
         */
        match /products/{productId} {
            allow get: if true;
            allow list: if true;
            allow create: if false; // TODO: Add admin validation once the schema is updated with an ownership field.
            allow update: if false; // TODO: Add admin validation once the schema is updated with an ownership field.
            allow delete: if false; // TODO: Add admin validation once the schema is updated with an ownership field.
        }

        /**
         * @description Allows public read access to categories, but restricts write access.
         * @path /categories/{categoryId}
         * @allow (get) - Any user can read category details.
         * @allow (list) - Any user can list categories.
         * @deny (create) - Only authenticated admins can create a category.
         * @deny (update) - Only authenticated admins can update a category.
         * @deny (delete) - Only authenticated admins can delete a category.
         * @principle Public read access with restricted write access.
         */
        match /categories/{categoryId} {
            allow get: if true;
            allow list: if true;
            allow create: if false; // TODO: Add admin validation once the schema is updated with an ownership field.
            allow update: if false; // TODO: Add admin validation once the schema is updated with an ownership field.
            allow delete: if false; // TODO: Add admin validation once the schema is updated with an ownership field.
        }
  }
}