rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // تحذير أمني خطير
    // -------------------------------------------------------------------------
    // هذه القاعدة تسمح لأي مستخدم مسجل الدخول بقراءة وكتابة أي بيانات
    // في قاعدة البيانات بأكملها. هذا يجعل بياناتك عرضة للتلاعب والسرقة
    // من قبل أي مستخدم. تم تطبيق هذه القاعدة بناءً على طلب المستخدم
    // الصريح لتجاوز مشاكل الصلاحيات. يوصى بشدة بالعودة إلى قواعد
    // أمان أكثر تقييدًا في أقرب وقت ممكن.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
