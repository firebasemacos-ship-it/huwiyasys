/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership and role-based access control.
 * Users have full control over their own profile data and transaction history.
 * Public read access is granted to products and categories, but writes are restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/transactions/{transactionId}: Stores a user's transaction history.
 * - /admins/{adminId}: Stores profile information for admin users. Access to this collection is not explicitly defined.
 * - /products/{productId}: Stores product information.
 * - /categories/{categoryId}: Stores category information.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data and transaction history.
 * - Listing all users is disallowed for privacy.
 * - Products and categories are publicly readable. Write access to these collections is not defined.
 *
 * Denormalization for Authorization:
 *  - User IDs are used within the path to the user's documents.
 *
 * Structural Segregation:
 *  - Private user data (transactions) is stored in a subcollection under the user's profile, ensuring only the owner can access it.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to manage their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' can create their profile if request.auth.uid == userId.
     * @allow (get, update, delete) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' can get, update, and delete their profile if request.auth.uid == userId.
     * @deny (create) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' cannot create a profile with a different userId.
     * @deny (get, update, delete) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' cannot get, update, or delete another user's profile.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows users to manage their own transaction history.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' can create a transaction in their own profile.
     * @allow (get, update, delete) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' can get, update, and delete transactions in their own profile.
     * @deny (create) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' cannot create a transaction in another user's profile.
     * @deny (get, update, delete) - User with UID 'd6GfvDONwmYUsBTr49PnQc5kaUy2' cannot get, update, or delete transactions in another user's profile.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to product information, restricts write access.
     * @path /products/{productId}
     * @allow (get, list) - Any user can get or list products.
     * @deny (create, update, delete) - No user can create, update, or delete products.
     * @principle Public read access with restricted writes.
     */
    match /products/{productId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

      /**
       * @description Allows public read access to category information, restricts write access.
       * @path /categories/{categoryId}
       * @allow (get, list) - Any user can get or list categories.
       * @deny (create, update, delete) - No user can create, update, or delete categories.
       * @principle Public read access with restricted writes.
       */
    match /categories/{categoryId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }
    
    /**
     * @description Access to admin profiles is not explicitly defined. Denying all access for safety.
     * @path /admins/{adminId}
     * @deny (get, list, create, update, delete) - No user can access admin profiles.
     * @principle Restricting access to admin profiles.
     */
    match /admins/{adminId} {
      allow get, list, create, update, delete: if false;
    }

    /**
     * @description  No access to cardLinkRequests
     * @path /cardLinkRequests
     * @deny (get, list, create, update, delete) - No user can access cardLinkRequests.
     * @principle Restricting access to cardLinkRequests.
     */
    match /cardLinkRequests {
      allow get, list, create, update, delete: if false;
    }
  }
}