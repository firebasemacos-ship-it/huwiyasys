/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes strict user-ownership and admin-role based access control.
 * It's designed for rapid prototyping, so data shape validation is relaxed to allow for flexibility
 * during development. However, authorization is always enforced.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owner and admins.
 * - /users/{userId}/transactions/{transactionId}: Transaction history for each user, accessible only to the owner.
 * - /admins/{adminId}: Admin user profiles.
 * - /products/{productId}: Products, publicly readable but manageable only by admins.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized data exposure.
 * - Ambiguous relationships default to strict owner-only access.
 * - Admin accounts are separate from user accounts for clearer role separation.
 *
 * Denormalization for Authorization:
 * None necessary at this stage.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to user profile information.
     * @path /users/{userId}
     * @allow (get, update, delete) User with matching ID.
     * @allow (create) User with matching ID, if isAdmin = false.
     * @deny (get, update, delete) User with non-matching ID.
     * @deny (create) User with non-matching ID.
     * @principle Enforces document ownership and restricts modification to owners only.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isAdmin() {
        return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid || isAdmin();
      allow delete: if isOwner(userId) && resource.data.uid == request.auth.uid || isAdmin();
    }

    /**
     * @description Grants access to user transaction history.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (get, list, create, update, delete) User with matching ID.
     * @deny (get, list, create, update, delete) User with non-matching ID.
     * @principle Enforces document ownership and restricts modification to owners only.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Grants access to admin user profiles.
     * @path /admins/{adminId}
     * @allow (get, update, delete) Admin with matching ID.
     * @allow (create) Admin with matching ID.
     * @deny (get, update, delete) Admin with non-matching ID.
     * @deny (create) Admin with non-matching ID.
     * @principle Enforces document ownership and restricts modification to owners only.
     */
    match /admins/{adminId} {
      function isOwner(adminId) {
        return request.auth.uid == adminId;
      }
      function isAdmin() {
        return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
      }
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(adminId) && request.resource.data.uid == request.auth.uid && request.resource.data.isAdmin == true;
      allow update: if isOwner(adminId) && request.resource.data.uid == resource.data.uid || isAdmin();
      allow delete: if isOwner(adminId) && resource.data.uid == request.auth.uid || isAdmin();
    }

    /**
     * @description Grants access to product information.
     * @path /products/{productId}
     * @allow (get, list) Public access.
     * @allow (create, update, delete) Admin users only.
     * @deny (create, update, delete) Non-admin users.
     * @principle Allows public read access but restricts writes to administrators.
     */
    match /products/{productId} {
        function isAdmin() {
            return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
        }

        allow get: if true;
        allow list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
  }
}